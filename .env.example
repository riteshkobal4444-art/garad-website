# =============================================================================
# Garad Foundation — Server-Side Environment Variables
# Configure these in Vercel Project Settings -> Environment Variables
# (and in local .env for development). NEVER expose secrets with VITE_ prefix.
# =============================================================================

# Razorpay API Credentials (start with Test Mode rzp_test_ keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase PostgreSQL (server-side service role only — never expose to browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Security & Token Signing Secrets (generate 32-byte random hex strings)
# Used to encrypt stored donor PAN numbers (AES-256-GCM) and sign receipt tokens
PAN_ENCRYPTION_KEY=
RECEIPT_TOKEN_SECRET=

# Admin Export Passcode for Accounting / Form 10BD CSV Exports
ADMIN_EXPORT_PASSCODE=

# Configurable Legal & 80G Organisation Details for Branded Acknowledgements
ORG_LEGAL_NAME="Garad Foundation"
ORG_ADDRESS="Thane, Maharashtra, India"
ORG_PAN=""
ORG_80G_APPROVAL_NUMBER=""
ORG_80G_VALIDITY_NOTE="80G approval details — update with official URN from approval certificate"
ORG_CONTACT_EMAIL=""

# Corporate CSR Partnership Enquiry Email Delivery (server-side only — never use VITE_ prefix)
# Confirm official Garad Foundation inbox before enabling production email notifications.
CSR_ENQUIRY_TO_EMAIL=
CSR_EMAIL_FROM=
RESEND_API_KEY=

# Volunteer Application Email Delivery & Private Resume Bucket (server-side only)
# Leave VOLUNTEER_ENQUIRY_TO_EMAIL blank to fall back to verified ORG_CONTACT_EMAIL.
VOLUNTEER_ENQUIRY_TO_EMAIL=
VOLUNTEER_EMAIL_FROM=
VOLUNTEER_RESUME_BUCKET=volunteer-resumes

# Garad Learning Hub Session Enquiry Email Delivery (server-side only)
# Falls back to verified ORG_CONTACT_EMAIL / CSR_EMAIL_FROM when left blank.
LEARNING_HUB_ENQUIRY_TO_EMAIL=
LEARNING_HUB_EMAIL_FROM=

# Runtime App URL
APP_URL=""
